{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "types": ["vite/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*.mjs"],
  "exclude": ["dist", "node_modules", "_legacy"]
}
