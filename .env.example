# Base URL for heavy assets (panoramas, GLB models). Leave empty to serve from /public.
# Production: point at a CDN bucket, e.g. https://cdn.kristalkule.com or https://pub-xxxx.r2.dev
PUBLIC_ASSET_BASE=
# Canonical site URL (used for sitemap, OG tags, JSON-LD)
PUBLIC_SITE_URL=https://kristalkule.com

