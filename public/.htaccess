# Kristal Kule 360 - Apache / LiteSpeed paylaşımlı hosting ayarları.
# Amaç: doğru MIME türleri (özellikle modül betikleri için), uzun önbellek, sıkıştırma.

<IfModule mod_mime.c>
  AddType text/javascript            .js .mjs
  AddType text/css                   .css
  AddType application/json           .json
  AddType image/webp                 .webp
  AddType image/avif                 .avif
  AddType image/svg+xml              .svg
  AddType image/ktx2                 .ktx2
  AddType model/gltf-binary          .glb
  AddType model/gltf+json            .gltf
  AddType application/wasm           .wasm
  AddType font/woff2                 .woff2
  AddCharset utf-8 .js .mjs .css .json .svg .html
</IfModule>

<IfModule mod_headers.c>
  # Hash'li derleme çıktısı ve ağır dosyalar: uzun süre önbellekle.
  <FilesMatch "\.(js|mjs|css|woff2|wasm|ktx2|glb|webp|avif|svg|jpg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML ve hotspots.json her ziyarette doğrulansın (Kaydet sonrası anında görünsün).
  <FilesMatch "\.(html|json|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Sıkıştırma: sunucu modülü varsa anında sıkıştırır; yoksa dosyalar düz gider.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>

Options -Indexes
